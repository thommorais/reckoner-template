		"./use-pagination": "./src/use-pagination.ts",
		"./use-reduced-motion": "./src/use-reduced-motion.ts",
		"./use-scroll-direction": "./src/use-scroll-direction.ts",
		"./use-uncontrolled": "./src/use-uncontrolled.ts",
