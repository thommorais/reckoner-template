		"./use-debounced-callback": "./src/use-debounced-callback.ts",
		"./use-debounced-value": "./src/use-debounced-value.ts",
		"./use-did-update": "./src/use-did-update.ts",
		"./use-disclosure": "./src/use-disclosure.ts",
		"./use-haptic": "./src/use-haptic.ts",
		"./use-headroom": "./src/use-headroom.ts",
		"./use-idle-queue": "./src/use-idle-queue.ts",
		"./use-intersection-observer": "./src/use-intersection-observer.ts",
		"./use-isomorphic-effect": "./src/use-isomorphic-effect.ts",
		"./use-keybindings": "./src/use-keybindings.ts",
		"./use-local-storage": "./src/use-local-storage.ts",
		"./use-logger": "./src/use-logger.ts",
		"./use-long-press": "./src/use-long-press.ts",
