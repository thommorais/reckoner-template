		"./use-keybindings": "./src/use-keybindings.ts",
		"./use-local-storage": "./src/use-local-storage.ts",
		"./use-long-press": "./src/use-long-press.ts",
		"./use-measure": "./src/use-measure.ts",
		"./use-media-query": "./src/use-media-query.ts",
		"./use-network": "./src/use-network.ts",
		"./use-pagination": "./src/use-pagination.ts",
